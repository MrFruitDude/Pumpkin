# A whitelist of files that should be included into Docker.
# Put an exclaimation mark before everything to include.

# Ignore everything
*

# Allow the source code folders
!/crates/
!/tools/
!/assets/

# Image defaults, entrypoint and backup scripts (not their tests)
!/docker/
/docker/tests/

# No .git: the Dockerfile keeps it out of the build so the cached release
# build survives commits that don't touch the Rust sources.

# Dependencies and toolchain
!Cargo.lock
!Cargo.toml
!rust-toolchain.toml

# Local build output never belongs in the context
/crates/**/target
